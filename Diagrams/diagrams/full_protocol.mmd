sequenceDiagram
    autonumber
    participant D  as Device (D)
    participant AS as Auth Server (AS)
    participant GW as Gateway (GW)

    %%─────────────────── PHASE 1: REGISTRATION ───────────────────
    rect rgb(230, 242, 255)
        Note over D,AS: ══════════  Phase 1: Registration  ══════════

        D->>AS: Registration Request

        Note over AS: Verify ID_D not exist  ·  Generate c_D ,  m_D

        AS-->>D: ( c_D ,  m_D )  [Secure Channel]

        Note over D: R_D = PUF_D(c_D)  ·  Generate y_D ,  c_AS-D<br/>Store  { y_D ,  c_D ,  m_curr = m_D }

        D-->>AS: ( y_D ,  R_D ,  c_AS-D )  [Secure Channel]

        Note over AS: Y_D^H = H(y_D)  ·  T_Acc = T_Acc & Y_D^H<br/>Φ_AS-D = PUF_AS(c_AS-D) ⊕ R_D<br/>Dual-state init:  m_curr = m_D ,  m_old = null<br/>PID_curr = H( ID_D ∥ m_curr ) ,  PID_old = null<br/>Store  { T_Acc ,  ID_D ,  Φ_AS-D ,  c_AS-D ,  m_curr ,  m_old ,  PID_curr ,  PID_old }
    end

    %%─────────────────── PHASE 2: AUTHENTICATION ─────────────────
    rect rgb(255, 243, 230)
        Note over D,AS: ══════════  Phase 2: Authentication  ══════════

        Note over D: R_D = PUF_D(c_D)  ·  ts_1 = timestamp<br/>PID = H( ID_D ∥ m_curr )   [pseudonym — hides ID_D]<br/>Y_AS-D^H = H(y_D) ⊕ H( R_D ∥ m_curr ∥ PID ∥ ts_1 )

        D->>AS: ( PID ,  Y_AS-D^H ,  ts_1 )

        Note over AS: Lookup device by PID_curr OR PID_old   [dual-state desync check]<br/>Check freshness of ts_1<br/>R_D' = Φ_AS-D ⊕ PUF_AS(c_AS-D)<br/>Y_D^H' = Y_AS-D^H ⊕ H( R_D' ∥ m_curr ∥ PID ∥ ts_1 )<br/>T_Acc^new = T_Acc & Y_D^H'<br/>If  T_Acc^new == T_Acc  →  Authenticated ✓
    end

    %%─────────────── PHASE 3: KEY EXCHANGE ───────────────────────
    rect rgb(230, 255, 236)
        Note over D,GW: ══════════  Phase 3: Key Exchange  ══════════

        Note over AS: m_new = H(n_1)  ·  ts_2 = timestamp<br/>m_H = m_new ⊕ H( Y_D^H' ∥ m_curr ∥ R_D' ∥ ID_AS ∥ PID_curr ∥ ts_2 )<br/>K_GW-D = H( R_D' ∥ m_new )  ·  PID_new = H( ID_D ∥ m_new )<br/>auth_token_D = SE( K_GW-AS ,  ID_D ∥ ID_AS ∥ K_GW-D ∥ PID_new ∥ ts_auth )<br/>Dual-state update:  m_old = m_curr ,  m_curr = m_new<br/>Dual-state update:  PID_old = PID_curr ,  PID_curr = PID_new

        par
            AS->>GW: ( ID_AS ,  auth_token_D )
        and
            AS->>D: ( Ack ,  m_H ,  ts_2 )
        end

        Note over GW: Decrypt auth_token_D with K_GW-AS  ·  Verify ts_auth<br/>Dual-state update:  PID_old = PID_curr (prev) ,  PID_curr = PID_new<br/>Store session keyed by PID_curr and PID_old  (both map to K_GW-D)

        Note over D: m_curr = m_H ⊕ H( Y_D^H ∥ m_curr ∥ R_D ∥ ID_AS ∥ PID_curr ∥ ts_2 )<br/>PID_curr = H( ID_D ∥ m_curr )  ·  K_GW-D = H( R_D ∥ m_curr )
    end

    %%─────────────── PHASE 4: DATA EXCHANGE ──────────────────────
    rect rgb(250, 230, 255)
        Note over D,GW: ══════════  Phase 4: Secure Data Exchange  ══════════

        loop Every Sensing Interval
            Note over D: PID_curr = H( ID_D ∥ m_curr )   [rotating pseudonym]<br/>C = AES( K_GW-D ,  data )

            D->>GW: ( PID_curr ,  AES( K_GW-D ,  data ) )

            Note over GW: Lookup by PID_curr OR PID_old   [dual-state desync recovery]<br/>Decrypt with K_GW-D

            GW-->>D: Ack
        end
    end
