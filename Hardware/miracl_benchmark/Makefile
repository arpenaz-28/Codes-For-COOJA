# =============================================================================
# Makefile — build benchmark_miracl on RPi 4B
# Run setup_miracl_rpi.sh first to generate ./miracl_core/
# =============================================================================

CC      = gcc
CFLAGS  = -O2 -I. -Wall
LDFLAGS = -L./miracl_core -lcore -lssl -lcrypto -lm

TARGET  = benchmark_miracl
SRC     = benchmark_miracl.c

# MIRACL Core object files (generated by config.py + make)
MIRACL_LIB = ./miracl_core/core.a

.PHONY: all clean check

all: check $(TARGET)

check:
	@if [ ! -f $(MIRACL_LIB) ]; then \
		echo ""; \
		echo "  ERROR: MIRACL Core library not found at $(MIRACL_LIB)"; \
		echo "  Run first:  ./setup_miracl_rpi.sh"; \
		echo ""; \
		exit 1; \
	fi

$(TARGET): $(SRC) $(MIRACL_LIB)
	$(CC) $(CFLAGS) -o $@ $< $(MIRACL_LIB) $(LDFLAGS)
	@echo ""
	@echo "  Build successful. Run:  ./$(TARGET)"
	@echo ""

clean:
	rm -f $(TARGET) *.o
