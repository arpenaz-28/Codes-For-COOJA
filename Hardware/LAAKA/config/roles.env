
# =============================================================================
# roles.env — LAAKA Hardware Simulation Configuration
#
# Topology:
#   Laptop      = Registration Authority (RA, Node ID 1) — runs gw_hw.py
#   RPi #1      = Fog Authentication Server (Node ID 2)  — runs as_hw.py
#   RPi #2      = Device Node (Node ID 81)               — runs node_hw.py
#
# Edit the three HOST lines below for your LAN.
# All other defaults match the LAAKA C source (project-conf.h).
# =============================================================================

# --- IP addresses (edit these for your LAN) ---
GW_HOST=192.168.1.202
AS_HOST=192.168.1.132
NODE_HOST=192.168.1.113

# --- SSH usernames (leave blank to default to "pi") ---
GW_USER=
AS_USER=apex
NODE_USER=pi

# --- SSH passwords (used by orchestrate_hw.py / paramiko) ---
AS_PASS=raspberrypi
NODE_PASS=raspberrypi

# --- Remote deployment paths ---
REMOTE_BASE_DIR=$HOME/mtp-hardware
PROJECT_DIR_NAME=LAAKA

# --- Role ports ---
GW_PORT=5683
AS_PORT=5684
NODE_PORT=5685

# --- Bind addresses ---
GW_BIND=0.0.0.0
AS_BIND=0.0.0.0
NODE_BIND=0.0.0.0

# --- Node IDs (match project-conf.h) ---
AS_NODE_ID=2
DEVICE_ID=81

# --- Data loop parameters ---
NODE_SEND_COUNT=10
NODE_SEND_INTERVAL_S=3

# --- Hardware energy model ---
CPU_POWER_W=2.5
NET_ENERGY_PER_BYTE_J=0.000002
