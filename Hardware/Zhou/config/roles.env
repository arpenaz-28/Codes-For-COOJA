
# =============================================================================
# roles.env — Zhou Scheme Hardware Simulation Configuration
#
# Topology:
#   Laptop      = GW Server + GW Router  (runs gw_server_hw.py + gw_router_hw.py)
#   RPi #1      = Sensor Node  (SN, node ID 4)   — runs sn_hw.py
#   RPi #2      = User Device  (User, node ID 81) — runs user_hw.py
#
# Edit the IP addresses below for your LAN.
# All crypto constants match Zhou-Scheme/gw-server.c, sn-node.c, user-node.c.
# =============================================================================

# --- IP addresses (EDIT THESE for your LAN) ---
GW_HOST=192.168.1.202
SN_HOST=192.168.1.132
USER_HOST=192.168.1.113

# --- SSH usernames ---
GW_USER=
SN_USER=apex
USER_USER=pi

# --- SSH passwords (used by orchestrate_hw.py / paramiko) ---
SN_PASS=raspberrypi
USER_PASS=raspberrypi

# --- Remote deployment paths ---
REMOTE_BASE_DIR=$HOME/mtp-hardware
PROJECT_DIR_NAME=Zhou

# --- Ports ---
GW_ROUTER_PORT=5683
GW_SERVER_PORT=5684
SN_PORT=5685
USER_PORT=5686

# --- Bind addresses ---
GW_BIND=0.0.0.0

# --- Node IDs (must match project-conf.h) ---
SN_ID=4
USER_ID=81

# --- Data loop parameters ---
USER_SEND_COUNT=10
USER_SEND_INTERVAL_S=3
USER_START_DELAY_S=30

# --- Hardware energy model ---
CPU_POWER_W=2.5
NET_ENERGY_PER_BYTE_J=0.000002
